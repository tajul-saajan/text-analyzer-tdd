# Test fixtures — NOT secrets. Committed deliberately so `npm test` works on a
# clean clone with no local setup. Loaded by src/tests/setup.ts.
#
# A developer's own .env takes precedence: dotenv never overrides variables that
# are already set, so these only fill in what is missing.
SECRET_KEY=test-secret-key
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_DURATION_MINUTES=15
